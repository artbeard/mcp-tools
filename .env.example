# Локальные секреты mcp-tools (не коммитить .env / .env.local)
# cp .env.example .env
# опционально: .env.local - переопределения поверх .env

# Yandex Tracker
TRACKER_BASE_URL=https://api.tracker.yandex.net
TRACKER_ORG_ID=
TRACKER_CLOUD_ORG_ID=
TRACKER_CLIENT_ID=
TRACKER_CLIENT_SECRET=
TRACKER_OAUTH_TOKEN=

# GitLab
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
# Опционально: CSV username/name/email/id для фильтра notes в gitlab_mr_context (пусто = все)
