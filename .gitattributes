# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicit text types
*.md text eol=lf
*.py text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
Makefile text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.example text eol=lf
*.conf text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
LICENSE text eol=lf

# Binary (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.whl binary
*.pyc binary
