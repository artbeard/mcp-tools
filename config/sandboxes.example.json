{
  "projects": [
    {
      "key": "example-app",
      "sources": ["example-app"],
      "aliases": ["example"]
    }
  ],
  "components": [
    {
      "project": "example-app",
      "component": "backend",
      "directory": "/absolute/path/to/example-app/backend",
      "runtime": "compose",
      "start_command": ["docker", "compose", "up", "-d"],
      "stop_command": ["docker", "compose", "down"],
      "probe": {"type": "compose"},
      "timeout_seconds": 60
    },
    {
      "project": "example-app",
      "component": "frontend",
      "directory": "/absolute/path/to/example-app/frontend",
      "runtime": "tmux",
      "session": "sandbox-example-app-frontend",
      "start_command": ["npm", "run", "dev"],
      "stop_command": [],
      "probe": {"type": "http", "url": "http://127.0.0.1:3000/"},
      "timeout_seconds": 30
    }
  ]
}
