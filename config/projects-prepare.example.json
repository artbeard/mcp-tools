{
  "protected_base_branches": ["master", "main"],
  "projects": [
    {
      "key": "example-app",
      "type": "multi_repo",
      "workspace": "/absolute/path/to/example-app",
      "repositories": [
        {
          "label": "backend",
          "path": "/absolute/path/to/example-app/backend",
          "remote": "origin",
          "base_branch": "master"
        },
        {
          "label": "frontend",
          "path": "/absolute/path/to/example-app/frontend",
          "remote": "origin",
          "base_branch": "master"
        }
      ]
    },
    {
      "key": "example-mono",
      "type": "monorepo",
      "workspace": "/absolute/path/to/example-mono",
      "repositories": [
        {
          "label": "monorepo",
          "path": "/absolute/path/to/example-mono",
          "remote": "origin",
          "base_branch": "main"
        }
      ]
    }
  ]
}
